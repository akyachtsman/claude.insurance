# Node dependencies
node_modules/

# Per-repo MCP/backend config — holds connection details, never commit (see data directive)
.claude/mcp.json

# Local key/secret files — never commit
.env
.env.*

# Playwright generated output (package-lock.json IS committed — qa.yml's
# `cache: npm` step requires it to resolve the dependency lock file)
.github/scripts/ui-tests/node_modules/
.github/scripts/ui-tests/test-results/
.github/scripts/ui-tests/playwright-report/
.agent-reports/

# Python bytecode from the CI guard scripts (check-job-bounds.py, workflow-ref-guard.py)
__pycache__/
*.pyc

# Transient input to the js/vendor regenerate procedure (js/vendor/README.md).
# The bundle it produces IS committed; the throwaway entry stub is not.
# js/vendor/package-lock.json IS committed — it is what makes the recorded
# sha256 reproducible, and `npm ci` requires it.
js/vendor/entry.mjs
